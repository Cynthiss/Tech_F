# Choose testnet or regtest
NETWORK=testnet

# Amount to send to the second wallet, in satoshis
AMOUNT_SATS=50000

# Optional fee rate in sat/vB. Leave empty to let WDK estimate it.
FEE_RATE=

# Testnet default: electrum.blockstream.info TLS 60002
# Regtest: point these values to your local Electrum/Fulcrum server.
ELECTRUM_HOST=electrum.blockstream.info
ELECTRUM_PORT=60002
ELECTRUM_PROTOCOL=tls
